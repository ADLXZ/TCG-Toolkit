# Local HTTP development only; production must use HTTPS.
TCG_PORT=8000
TCG_TRUSTED_ORIGINS=http://localhost:8000
TCG_USER_DB=data/users.sqlite3
# Exact trusted proxy source addresses. Never use * on an exposed service.
TCG_PROXY_IPS=127.0.0.1
RAPIDAPI_KEY=
